# Used by docker-compose for all services.

# Database
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=time_tracker
# Host port the Postgres container is published on (container is always 5432).
# Defaults to 5433 to avoid clashing with a local Postgres on 5432.
DB_HOST_PORT=5433

# Backend / Auth
JWT_SECRET=super-secret-change-me
JWT_EXPIRES_IN=7d

# Frontend -> Backend URL (used by the browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Mail (без SMTP_HOST письма логируются в консоль — dev-режим)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Хронос <no-reply@chronos.local>
FRONTEND_URL=http://localhost:3000

# Генератор текстов: AI-сводка (Claude API) и вебхуки доставки стендапа
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web Push (npx web-push generate-vapid-keys); без ключей пуши выключены,
# уведомления остаются в кабинете и в почте
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@chronos.local

# SSO (Auth 2.0): вход через Google и Яндекс.
# Провайдер включается парой clientId/clientSecret; без кредов кнопка скрыта.
# Redirect URI в консоли провайдера: <OAUTH_CALLBACK_BASE>/auth/oauth/<provider>/callback
#   Google:  https://console.cloud.google.com/apis/credentials  (OAuth client ID, Web)
#   Яндекс:  https://oauth.yandex.ru  (доступ: логин, email, аватар)
OAUTH_CALLBACK_BASE=http://localhost:3001/api
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
